{
  "name": "ab-sign",
  "productName": "A-B Sign",
  "version": "0.1.0",
  "description": "Offline Filipino Sign Language teaching and practice for desktop.",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "npm run build && electron .",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "build": "tsc -p tsconfig.electron.json && vite build && node scripts/copy-vision-assets.mjs",
    "smoke": "electron . --smoke-test",
    "make": "npm run build && electron-forge make --platform=win32 --arch=x64"
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "5.3.0",
    "@fontsource/varela-round": "5.3.0",
    "@mediapipe/tasks-vision": "1.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "45.3.4",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
